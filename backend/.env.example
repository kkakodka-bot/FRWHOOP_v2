# Server-only. Do not put B2 keys or SUPABASE_SERVICE_ROLE_KEY in a client app.

PORT=8080
NODE_ENV=development
# Production container/runtime: NODE_ENV=production FRWHOOP_RUNTIME=production
# Production requires ALL of: SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY, INGEST_SECRET, B2_KEY_ID, B2_APPLICATION_KEY,
# FRWHOOP_DEVICE_TOKEN (must match the phone's VITE_FRWHOOP_DEVICE_TOKEN).
# Missing any of those fails startup. There is no RPC-only or B2-less fallback.
# INGEST_SECRET gates engine RPCs (settings sync, scoring); it is not NOOP push identity.
# Mint a per-user opaque ingest token via POST /api/push/tokens (JWT required).

MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
DEEPINFRA_API_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Must be the service_role JWT (role=service_role), not the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# Strava OAuth — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8080/api/integrations/strava/callback
APP_RETURN_URL=http://localhost:5173/

# Backblaze B2 — raw live HR/PPG and derived sleep JSON in one private bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=FRWHOOP
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_RAW_SYNC_ENABLED=true
RAW_STORE=b2
DERIVED_STORE=b2

# Dev-only identity. Ignored in production (JWT auth.users.id is canonical).
FRWHOOP_LOCAL_USER_ID=
FRWHOOP_ALLOW_DEV_USER=false
FRWHOOP_DEVICE_TOKEN=

# Shadow-only step algorithms. Canonical daily steps remain frwhoop-steps-v1.
FRWHOOP_STEPS_V2=shadow
FRWHOOP_STEPS_V3_ARTIFACT=
FRWHOOP_STEPS_V3_ARTIFACT_SHA256=

# HR V2: dual keeps V1 columns canonical. Never FRWHOOP_HR2=v2 for product.
FRWHOOP_HR2=dual

# Strain V2 shadow beside strain_score. Never a registry promotion.
FRWHOOP_STRAIN_V2=shadow

# Energy V2 shadow when the committed artifact exists. `on` is still shadow at persist.
ENERGY_MODEL_V2=shadow
# Energy V3 stays off: this corpus has 0 complete v21 frames.
ENERGY_MODEL_V3=off

# Sleep V3: off | shadow | beta. Default shadow. Never global beta.
# beta requires FRWHOOP_SLEEP_V3_BETA_USERS and a real ONNX artifact to surface
# V3; missing artifact keeps V2 canonical (infrastructure beta).
FRWHOOP_SLEEP_V3=shadow
FRWHOOP_SLEEP_V3_BETA_USERS=
FRWHOOP_SLEEP_V3_ARTIFACT=
FRWHOOP_SLEEP_V3_ARTIFACT_SHA256=
# Tier 2 ingest: archive flush decoupled from scoring (default on).
FRWHOOP_INGEST_SCORE_ASYNC=on
# NOOP push ingest quota (per user, rolling window). Disabled when any limit is 0.
FRWHOOP_PUSH_QUOTA_MAX_BATCHES=10000
FRWHOOP_PUSH_QUOTA_MAX_BYTES=536870912
FRWHOOP_PUSH_QUOTA_WINDOW_SEC=3600
# Coalesce affected-day recompute within this window (ms).
FRWHOOP_SCORE_DEBOUNCE_MS=2000
INGEST_SECRET=
STORAGE_CRON_SECRET=
